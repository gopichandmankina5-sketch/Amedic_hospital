<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/color_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Doctor Avatar -->
        <androidx.cardview.widget.CardView
            android:layout_width="64dp"
            android:layout_height="64dp"
            app:cardCornerRadius="32dp"
            app:cardBackgroundColor="@color/color_primary_light">

            <ImageView
                android:id="@+id/doctorImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_doctor"
                android:scaleType="centerCrop"
                android:padding="14dp" />
        </androidx.cardview.widget.CardView>

        <!-- Doctor Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/doctorName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dr. John Smith"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/color_on_surface" />

            <TextView
                android:id="@+id/doctorSpecialization"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cardiologist"
                android:textSize="13sp"
                android:textColor="@color/color_primary"
                android:layout_marginTop="2dp" />

            <!-- Rating + Experience row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_star" />

                <TextView
                    android:id="@+id/doctorRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4.8"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_on_surface"
                    android:layout_marginStart="3dp" />

                <View
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:background="@color/color_text_hint"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/doctorExperience"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10 yrs exp"
                    android:textSize="12sp"
                    android:textColor="@color/color_text_secondary" />

            </LinearLayout>
        </LinearLayout>

        <!-- Availability chip + Arrow -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <com.google.android.material.chip.Chip
                android:id="@+id/availabilityChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Available"
                android:textSize="11sp"
                app:chipMinHeight="24dp"
                app:chipBackgroundColor="@color/status_confirmed_bg"
                android:textColor="@color/status_confirmed"
                android:clickable="false" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
