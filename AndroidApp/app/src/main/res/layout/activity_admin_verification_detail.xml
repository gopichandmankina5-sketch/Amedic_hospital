<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_surface_variant">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_surface"
        app:elevation="2dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_back"
            app:title="Doctor Verification"
            app:titleTextColor="@color/color_on_background" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Loading Bar -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:visibility="visible" />

            <!-- ─── DOCTOR PROFILE CARD ─────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDoctorProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/color_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Photo + Name + Spec -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <androidx.cardview.widget.CardView
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            app:cardCornerRadius="36dp"
                            app:cardElevation="2dp">
                            <ImageView
                                android:id="@+id/ivDoctorPhoto"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/ic_doctor"
                                android:scaleType="centerCrop"
                                android:padding="16dp" />
                        </androidx.cardview.widget.CardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="16dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvDoctorName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Dr. Name"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/color_on_surface" />

                            <TextView
                                android:id="@+id/tvSpecialization"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Specialization"
                                android:textSize="13sp"
                                android:textColor="@color/color_primary" />

                            <!-- Verification Status Chip -->
                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipVerificationStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="PENDING"
                                android:textSize="11sp"
                                app:chipStrokeWidth="0dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Info rows -->
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/color_divider" android:layout_marginBottom="12dp" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginBottom="8dp">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:src="@drawable/ic_email" app:tint="@color/color_text_secondary" />
                        <TextView android:id="@+id/tvEmail" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:layout_marginStart="10dp"
                            android:textSize="13sp" android:textColor="@color/color_text_secondary" android:text="—" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginBottom="8dp">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:src="@drawable/ic_phone" app:tint="@color/color_text_secondary" />
                        <TextView android:id="@+id/tvPhone" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:layout_marginStart="10dp"
                            android:textSize="13sp" android:textColor="@color/color_text_secondary" android:text="—" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginBottom="8dp">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:src="@drawable/ic_hospital" app:tint="@color/color_text_secondary" />
                        <TextView android:id="@+id/tvQualification" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:layout_marginStart="10dp"
                            android:textSize="13sp" android:textColor="@color/color_text_secondary" android:text="—" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginBottom="8dp">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:src="@drawable/ic_calendar" app:tint="@color/color_text_secondary" />
                        <TextView android:id="@+id/tvExperience" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:layout_marginStart="10dp"
                            android:textSize="13sp" android:textColor="@color/color_text_secondary" android:text="—" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:src="@drawable/ic_verified" app:tint="@color/color_text_secondary" />
                        <TextView android:id="@+id/tvRegNumber" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:layout_marginStart="10dp"
                            android:textSize="13sp" android:textColor="@color/color_text_secondary" android:text="Reg No: —" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ─── VERIFICATION CHECKLIST CARD ─────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardChecklist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/color_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Verification Checklist"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_on_surface"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvDocumentProgress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 of 4 documents uploaded"
                        android:textSize="12sp"
                        android:textColor="@color/color_text_secondary"
                        android:layout_marginBottom="16dp" />

                    <!-- Checklist Items -->
                    <LinearLayout android:id="@+id/checklistMedReg"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">
                        <ImageView android:id="@+id/ivCheckMedReg"
                            android:layout_width="22dp" android:layout_height="22dp"
                            android:src="@drawable/ic_close" app:tint="#F57C00" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginStart="12dp" android:text="Medical Registration Certificate"
                            android:textSize="13sp" android:textColor="@color/color_on_surface" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/checklistMedDegree"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">
                        <ImageView android:id="@+id/ivCheckMedDegree"
                            android:layout_width="22dp" android:layout_height="22dp"
                            android:src="@drawable/ic_close" app:tint="#F57C00" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginStart="12dp" android:text="Medical Degree Certificate"
                            android:textSize="13sp" android:textColor="@color/color_on_surface" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/checklistGovtId"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">
                        <ImageView android:id="@+id/ivCheckGovtId"
                            android:layout_width="22dp" android:layout_height="22dp"
                            android:src="@drawable/ic_close" app:tint="#F57C00" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginStart="12dp" android:text="Government ID"
                            android:textSize="13sp" android:textColor="@color/color_on_surface" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/checklistExpCert"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <ImageView android:id="@+id/ivCheckExpCert"
                            android:layout_width="22dp" android:layout_height="22dp"
                            android:src="@drawable/ic_close" app:tint="#F57C00" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginStart="12dp" android:text="Experience Certificate (optional)"
                            android:textSize="13sp" android:textColor="@color/color_on_surface" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ─── VERIFICATION DOCUMENTS CARD ─────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDocuments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/color_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Verification Documents"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_on_surface" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="16dp"
                        android:text="Review the doctor's submitted documents before verification."
                        android:textSize="12sp"
                        android:textColor="@color/color_text_secondary" />

                    <!-- No documents state -->
                    <TextView
                        android:id="@+id/tvNoDocuments"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No documents uploaded yet."
                        android:gravity="center"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="13sp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:visibility="gone" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvDocuments"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ─── Missing documents warning ────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMissingDocsWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="#FFF3E0"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#F57C00"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/ic_notifications" app:tint="#F57C00" />
                    <TextView
                        android:id="@+id/tvMissingDocsMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Required verification documents are missing. Please review the doctor's submission before verification."
                        android:textColor="#E65100"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ─── ACTION BUTTONS ────────────────────────────── -->
            <LinearLayout
                android:id="@+id/actionButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="32dp"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReject"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Reject"
                    android:textColor="@color/color_error"
                    app:strokeColor="@color/color_error"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVerifyDoctor"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Verify Doctor"
                    app:cornerRadius="12dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
